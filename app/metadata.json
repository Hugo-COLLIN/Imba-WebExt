{
  "name": "WebExtension Example",
  "version": "1.0",
  "description": "Description",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.imba"]
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "options_ui": {
    "page": "ui/options.imba"
  },
  "chrome": {
    "manifest_version": 3,
    "action": {
      "default_popup": "ui/popup.imba",
      "default_title": "Action title",
      "default_icon": {
        "16": "assets/icons/icon16.png",
        "48": "assets/icons/icon48.png",
        "128": "assets/icons/icon128.png"
      }
    },
    "background": {
      "service_worker": "background.imba"
    }
  },
  "firefox": {
    "manifest_version": 2,
    "browser_action": {
      "default_popup": "ui/popup.imba",
      "default_title": "Action title",
      "default_icon": {
        "16": "assets/icons/icon16.png",
        "48": "assets/icons/icon48.png",
        "128": "assets/icons/icon128.png"
      }
    },
    "background": {
      "scripts": ["background.imba"]
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "myextension@example.com",
        "strict_min_version": "109.0"
      }
    }
  }
}