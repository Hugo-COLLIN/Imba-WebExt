{
    "scripts": {
        "dev": "bun run build.imba --watch",
        "dev:firefox": "bun run build.imba --firefox --watch",
        "build": "bun run build.imba",
        "build:firefox": "bun run build.imba --firefox",
        "pack": "bun run build.imba --pack",
        "pack:firefox": "bun run build.imba --firefox --pack",
        "release": "bun run pack && bun run pack:firefox",
        "test": "bun run build.imba --test",
        "test:watch": "bun run build.imba --test --watch"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "fflate": "^0.8.3",
        "imba": "^2.0.0-alpha.253"
    },
    "dependencies": {
        "webextension-polyfill": "^0.12.0"
    }
}